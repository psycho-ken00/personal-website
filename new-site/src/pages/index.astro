---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
import { experience, education, honors, skills } from '../data/home';
import { sitePath } from '../lib/paths';
const projects = (await getCollection('cases')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const projectsById = new Map(projects.map((project) => [project.id, project]));
---

<BaseLayout>
  <section class="hero container" id="about" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{profile.name}</p>
      <h1 id="hero-title">{profile.headline}</h1>
      <p class="role-list" aria-label="求职方向">{profile.roles.join(' · ')}</p>
      <div class="hero-intro">
        <p class="hero-lead">{profile.introduction}</p>
        <p>{profile.about}</p>
      </div>
    </div>
    <figure class="portrait-card">
      <img class="portrait-image" src={sitePath('/images/portrait-illustration.jpg')} alt="陈泽锋在书桌前的风格化个人形象" width="1000" height="1000" fetchpriority="high" />
    </figure>
  </section>

  <section class="section container" id="projects" aria-labelledby="projects-title">
    <SectionHeading eyebrow="SELECTED WORK" title="精选项目" id="projects-title" description="从人因研究到 AI 产品实践，呈现问题、方法与决策之间的连接。" />
    <ProjectCarousel projects={projects} />
  </section>

  <section class="section career-section" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <SectionHeading eyebrow="JOURNEY" title="专业经历与教育背景" id="experience-title" description="从研究训练走向真实产品问题，持续积累可用于决策的证据。" />
      <div class="career-grid">
        <section class="career-column" aria-labelledby="internship-heading">
          <h3 id="internship-heading">实习经历</h3>
          <ol class="career-list">
            {experience.map((item) => <li class="career-card"><time>{item.period}</time><h4>{item.organization}</h4><p class="career-role">{item.role}</p><p>{item.summary}</p><div class="internship-projects" aria-label={`${item.organization}实习项目`}>{item.projectIds.map((id) => { const project = projectsById.get(id); return project && <a class="internship-project" href={sitePath(`/cases/${id}/`)}><span class={`internship-project-art art-${project.data.art}`} aria-hidden="true"></span><span><small>{project.data.category}</small><strong>{project.data.title}</strong><em>{project.data.summary}</em></span></a>; })}</div></li>)}
          </ol>
        </section>
        <section class="career-column" id="education" aria-labelledby="education-heading">
          <h3 id="education-heading">教育背景</h3>
          <ol class="career-list education-list">
            {education.map((item) => <li class="career-card"><div class="education-entry"><img class="school-logo" src={sitePath(item.logo)} alt={item.logoAlt} width="80" height="80" loading="lazy" /><div><time>{item.period}</time><h4>{item.school}</h4></div></div>{'ranking' in item && <p class="school-ranking">{item.ranking}</p>}<p class="education-summary">{item.degree}·{item.detail}</p>{'teaching' in item && <p class="teaching-note">助教经历 · {item.teaching}</p>}</li>)}
          </ol>
          <aside class="honors-card" aria-labelledby="honors-heading"><h4 id="honors-heading">在校荣誉</h4><p>{honors.map((item) => item.title).join('、')}</p></aside>
        </section>
      </div>
    </div>
  </section>

  <section class="section skills-section" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <SectionHeading eyebrow="CAPABILITIES" title="能力与方法" id="skills-title" description="能力来自具体项目，也服务于下一次研究与产品决策。" />
      <div class="skills-grid">
        {skills.map((group) => <article><h3>{group.title}</h3><p>{group.description}</p><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}
      </div>
    </div>
  </section>

  <section class="section container research-section" id="research" aria-labelledby="research-title">
    <div class="research-copy">
      <p class="eyebrow">RESEARCH</p>
      <h2 id="research-title">研究让问题更清晰</h2>
      <p>研究主题涵盖人机信任、智能驾驶交互、认知与行为。已有 3 篇期刊论文和 2 项第一作者会议海报；具体研究项目与书目信息可在研究页查看。</p>
      <a class="text-link" href={sitePath('/research/')}>查看研究成果</a>
    </div>
    <div class="research-art" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>
</BaseLayout>
